# ─────────────────────────────────────────────────────────────────────────────
# GUMADO frontend environment. Copy to .env.local (never commit real values).
# Both values are PUBLIC by design: they are shipped to every browser.
# Security comes from Row Level Security in the database, not from hiding them.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → anon / public key
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public contact details shown on the landing page (optional)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_WHATSAPP=

# ─────────────────────────────────────────────────────────────────────────────
# NEVER put these in this file or anywhere in the frontend:
#   SUPABASE_SERVICE_ROLE_KEY, database password, JWT secret.
# The invite-user Edge Function reads the service role key from Supabase's own
# secret store (it is injected automatically for Edge Functions).
# Set the redirect target for invite emails with:
#   supabase secrets set SITE_URL=https://your-domain.example
# ─────────────────────────────────────────────────────────────────────────────
